// LOCAL PLACEHOLDER WIT for the ZeroClaw `tool-plugin` world.
//
// This is a minimal, self-consistent definition covering exactly the
// imports/exports used by the plugin shims in this repo. It is NOT the
// upstream zeroclaw-plugins `wit/v0` — vendor the official WIT before any PR.
// The runtime's ABI may differ; this exists to make `cargo build
// --target wasm32-wasip2` succeed locally and to pin our interface assumptions.

package zeroclaw:plugin@0.1.0;

/// Structured logging import (host-provided). Mirrors the WIT `logging` import.
interface logging {
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    enum plugin-action {
        start,
        complete,
        fail,
    }

    enum plugin-outcome {
        success,
        failure,
        unknown,
    }

    record plugin-event {
        function-name: string,
        action: plugin-action,
        outcome: option<plugin-outcome>,
        duration-ms: option<u64>,
        attrs: option<list<tuple<string, string>>>,
        message: string,
    }

    /// Emit a structured log record. Never write to stdout in a component.
    log-record: func(level: log-level, event: plugin-event);
}

/// Plugin identity — exported by every component.
interface plugin-info {
    plugin-name: func() -> string;
    plugin-version: func() -> string;
}

/// A single callable tool — exported by every component.
interface tool {
    record tool-result {
        success: bool,
        output: string,
        error: option<string>,
    }

    name: func() -> string;
    description: func() -> string;
    /// JSON-schema string describing the tool's parameters.
    parameters-schema: func() -> string;
    /// Execute the tool with a JSON-encoded args string.
    execute: func(args: string) -> result<tool-result, string>;
}

world tool-plugin {
    import logging;
    export plugin-info;
    export tool;
}
